{
  "name": "sun-asterisk-pages",
  "version": "1.0.0",
  "private": true,
  "description": "Trang chủ Sun* Asterisk - dự án training",
  "scripts": {
    "dev": "concurrently \"npm:watch:css\" \"npm:serve\"",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --watch",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --minify",
    "serve": "live-server ."
  },
  "devDependencies": {
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20",
    "live-server": "^1.2.2",
    "concurrently": "^8.2.2"
  }
}